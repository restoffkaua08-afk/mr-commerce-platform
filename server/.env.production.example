NODE_ENV=production
HOST=0.0.0.0
PORT=8021
LOG_LEVEL=info
TRUST_PROXY=true

# Dominio publico do frontend autorizado a acessar a API.
CORS_ORIGIN=https://www.seudominio.com

# Dominio publico da API usado nos links afiliados /go/:publicCode.
REDIRECT_BASE_URL=https://api.seudominio.com

# Banco MariaDB/MySQL gerenciado em producao.
DB_HOST=seu-host-do-banco
DB_PORT=3306
DB_NAME=product_aggregator_mvp
DB_USER=seu-usuario
DB_PASSWORD=substitua-por-uma-senha-segura
DB_CONNECTION_LIMIT=10

# Gere um valor longo e aleatorio no ambiente da hospedagem.
CLICK_HASH_SECRET=substitua-por-um-segredo-aleatorio